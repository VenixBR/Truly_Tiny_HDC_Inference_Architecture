{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: Build Train_MNIST",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}/Train_MNIST.c",
                "${fileDirname}/hdc_utils.c",
                "-o",
                "${fileDirname}/Train_MNIST",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build do Train_MNIST."
        }
    ],
    "version": "2.0.0"
}
